{
  "name": "dsh-plugin-guide",
  "version": "0.5.8",
  "description": "A practical guide to DSH plugin quality: ENTRY checks, FLOW checks, and BOOST guidance. Community guide; not official, not a certification, not a ranking.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "SKILL.md",
    "docs",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "STANDARDS.md",
    "LICENSE",
    "NOTICE.md",
    "PRIVACY.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:pack": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-0 <0.3.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin-development",
    "standards",
    "checklist",
    "guide",
    "documentation"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-plugin-guide.git"
  },
  "homepage": "https://github.com/PerryLink/dsh-plugin-guide#readme",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-plugin-guide/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-0 <0.3.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "standards": {
      "schema": "dsh-levels/1",
      "entry": {
        "status": "not-run",
        "evidence": null
      },
      "flow": {
        "status": "not-run",
        "evidence": null
      },
      "boost": {
        "status": "not-measured",
        "evidence": null
      }
    }
  },
  "dshWorkshop": {
    "schema": "omdsh-workshop-package/v1",
    "type": "plugin",
    "integration": {
      "protocol": "harness-profile",
      "artifact": "cordis.patch.yml"
    },
    "install": {
      "mode": "transactional",
      "adapter": "profile-bundle",
      "failurePolicy": "generation-rollback",
      "touchesCurrentBeforeActivation": false
    },
    "lifecycle": {
      "activation": "restart-profile",
      "dispose": "supported"
    },
    "permissions": [
      "filesystem:read"
    ],
    "compatibility": {
      "dshVersions": [
        "0.2.2-rc.3"
      ]
    },
    "capability": {
      "id": "dsh-plugin-guide",
      "kind": "service",
      "invocation": "ctx.skills.get('dsh-plugin-guide') resolves a complete SkillDefinition",
      "expected": "session skill catalog lists dsh-plugin-guide and the loaded body points at docs/levels.md"
    },
    "evidence": {
      "install": null,
      "failureIsolation": null,
      "hotReload": null,
      "remove": null
    }
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/PerryLink"
  },
  "icon": "icon.svg"
}
